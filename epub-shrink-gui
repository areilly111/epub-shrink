#!/usr/bin/env bash
# Run the epub-shrink GUI from wherever this folder happens to live.
#
# This is only an interpreter picker. The real window is epub_shrink_gui.py,
# which imports epub_shrink_gui_qt.py, so the GUI stays importable and
# testable rather than being trapped inside a shell script.
#
# The interpreter is chosen in this order:
#   1. $EPUB_SHRINK_PYTHON, when the caller has set one
#   2. the venv in ~/.local/share/epub-shrink/venv (see install.sh)
#   3. whatever python3 is on PATH
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

if [[ -n "${EPUB_SHRINK_PYTHON:-}" ]]; then
    PY="$EPUB_SHRINK_PYTHON"
elif [[ -x "$HOME/.local/share/epub-shrink/venv/bin/python3" ]]; then
    PY="$HOME/.local/share/epub-shrink/venv/bin/python3"
else
    PY="python3"
fi

if ! "$PY" -c "import PySide6, PIL" 2>/dev/null; then
    cat >&2 <<EOF
epub-shrink-gui needs PySide6 and Pillow, and $PY does not have them.

Create the runtime with install.sh, or point at an interpreter that has them:

    ./install.sh
    # or
    EPUB_SHRINK_PYTHON=/path/to/python3 epub-shrink-gui
EOF
    exit 1
fi

exec "$PY" "$HERE/epub_shrink_gui.py" "$@"
